#!/bin/sh
# Copied from the prototyping skill. Installed via `git config core.hooksPath .githooks`.
# Every commit re-proves the standards and the locked flows — the "know the
# moment a flow changes" mechanism. Bypass deliberately with --no-verify only.
set -e
npm run gate
# The unit tier runs BEFORE the browser. A combinatorial fault should not wait
# three seconds behind a browser to report itself.
npx vitest run --passWithNoTests
npx playwright test --reporter=line --pass-with-no-tests
