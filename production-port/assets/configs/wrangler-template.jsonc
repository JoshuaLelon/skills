// Copied from the production-port skill — the comments ARE the config rules.
{
  "name": "[FILL: worker name]",
  "main": "./build/server/index.js",
  // ADR-0009: platform-native observability is the whole logging backend.
  // Structured console objects from lib/log get every field indexed.
  // traces: automatic spans for binding calls, subrequests and handlers.
  // FREE UNTIL 2026-10-01 — after that a span costs the same as a log event,
  // so 1.0 on BOTH keys is a real bill. Drop the TRACE rate first (logs carry
  // the wide event; traces are the supporting detail) — ADR-0009/ADR-0016.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true, // stack traces resolve to TS in Workers Logs
  // ADR-0019: measure before setting. Placement pays when a request makes
  // SEVERAL sequential DB round trips; a one-query route gains nothing. Use a
  // Hint (region/host) for one known single-homed DB; mode:"smart" only when
  // the backends are several, unknown, or replicated.
  // "placement": { "region": "[FILL: db region, e.g. aws:us-east-1]" },
  // ADR-0001: Hyperdrive with the DIRECT (non-pooler) Neon string — Hyperdrive
  // does the pooling. The -pooler string is for outside-Workers processes;
  // the bare direct string is for migrations only.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "[FILL: npx wrangler hyperdrive create]" }
  ],
  // Declared ONCE, top-level, never per-env: a demo on a different compat date
  // is a demo of different behaviour. Environments INHERIT this.
  "compatibility_date": "[FILL: today]",
  // `vars` does NOT inherit into environments — env.demo.vars REPLACES this
  // block. Every var must be repeated per env or it silently vanishes there.
  // Secrets never go here: `wrangler secret put <NAME> [--env demo]`.
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "demo": {
      "name": "[FILL: worker name]-demo",
      "vars": {
        "ENVIRONMENT": "demo"
        // …and every other var from the top-level block, repeated.
      }
    }
  }
  // DEPLOY RULE (enforced by check-config-traps): environment is selected at
  // BUILD time — CLOUDFLARE_ENV=demo npm run build — never `wrangler deploy
  // --env`, which matches nothing in the generated config and silently
  // deploys to production with exit 0.
}
