{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"typescript/no-explicit-any": "error",
		"no-floating-promises": "error",
		"no-console": "warn",
		"no-underscore-dangle": [
			"warn",
			{
				"allow": ["_fx"]
			}
		]
	},
	"ignorePatterns": ["dist/**", "build/**", "scripts/**", "node_modules/**"]
}
