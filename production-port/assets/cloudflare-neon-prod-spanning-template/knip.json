{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"src/routes.ts",
		"src/states.tsx",
		"e2e/**/*.spec.ts",
		"scripts/*.mjs",
		"integration/**/*.test.ts"
	],
	"project": ["src/**", "e2e/**", "scripts/**", "integration/**"],
	"include": ["files", "dependencies", "exports", "types", "duplicates"],
	"ignore": ["src/_port/**", "e2e/_port/**"],
	"tags": ["-@public"]
}
